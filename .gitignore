# PlatformIO build output, package state, and installed project dependencies.
**/.pio/
**/.pioenvs/
**/.piolibdeps/

# Per-user VS Code / C/C++ extension state. Shared recommendations remain tracked.
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch/
**/.vscode/*.log
*.code-workspace.user

# Generated Nextion output. The editable HMI source is intentionally tracked.
nextion/build/

# Editor and temporary files.
*.bak
*.tmp
*.swp
*.log
.DS_Store
Thumbs.db
